# syntax=docker/dockerfile:1

# 复用生产已验证的上游运行时，在其上覆盖 personal fork 的完整源码，
# 避免重新构建 Playwright/浏览器等大体积基础环境。
ARG WERSS_BASE_IMAGE=rachelos/we-mp-rss:latest
ARG NODE_IMAGE=node:22-alpine

FROM ${NODE_IMAGE} AS frontend
WORKDIR /src
COPY web_ui/package.json web_ui/package-lock.json ./
RUN npm ci
COPY web_ui/ ./
RUN npm run build

FROM ${WERSS_BASE_IMAGE} AS runtime
WORKDIR /app

# 依赖层只在 requirements.txt 变化时重跑。上游镜像的虚拟环境目录按架构命名，
# 例如 /app/env_x86_64。
COPY requirements.txt /tmp/we-mp-rss-requirements.txt
RUN set -eu; \
    venv="$(find /app -maxdepth 1 -type d -name 'env_*' | head -n 1)"; \
    test -n "$venv"; \
    "$venv/bin/python3" -m pip install --no-cache-dir \
      -r /tmp/we-mp-rss-requirements.txt; \
    rm -f /tmp/we-mp-rss-requirements.txt

# 覆盖完整源码，使以后对任意 Python 模块、模板或脚本的维护都能随构建生效。
# .dockerignore 已排除 .env、生产配置、data、旧 static 和本机构建目录。
COPY . /app/
RUN chmod +x /app/start.sh

# 先清空上游旧静态资源，避免旧登录 bundle 仍可被直接访问或被漏扫命中。
RUN rm -rf /app/static && mkdir -p /app/static
COPY --from=frontend /src/dist/ /app/static/
