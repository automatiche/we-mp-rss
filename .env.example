USERNAME=admin
PASSWORD=admin@123
TZ=Asia/Shanghai
WERSS_AUTH_WEB=True
AUTO_RELOAD=True
# 禁用级联模式（cascade），使用本地直抓
CASCADE_ENABLED=False
# 微信读书 Cookie（weread_mp 采集模式必需，从浏览器登录 weread.qq.com 后 F12 复制）
# 过期时替换此值并 docker compose restart we-mp-rss
WEREAD_COOKIE=wr_vid=...; wr_skey=...; wr_rt=...
WEREAD_VID=your_vid_here
# 迁移 MySQL 时取消注释下行，并设正确的连接信息
# DB=mysql+pymysql://rss_user:password@host/we_mp_rss?charset=utf8mb4
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=we_mp_rss
MYSQL_USER=rss_user
MYSQL_PASSWORD=pass123456
PROXY_ENABLED=False
PROXY_URL=socks5://<username>:<password>@p.webshare.io:80
