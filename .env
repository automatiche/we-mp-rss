TZ=Asia/Shanghai
WERSS_AUTH_WEB=True
# 禁用级联模式（cascade），使用本地直抓（2026-08-17 排查时确认必须禁用）
CASCADE_ENABLED=False
# 微信读书 Cookie（weread_mp 采集模式必需）
# 实际 Cookie 值写在 config.yaml 的 weread.cookie 里（config.yaml 被 .gitignore 忽略，不进 git）
# 或在此行填写后 docker compose restart we-mp-rss 生效
# WEREAD_COOKIE=wr_vid=...; wr_skey=...; wr_rt=...
# WEREAD_VID=43747660
# 迁移 MySQL 时取消注释下行，并设正确的连接信息
# DB=mysql+pymysql://rss_user:password@host/we_mp_rss?charset=utf8mb4
